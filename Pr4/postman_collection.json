        "url": {
          "raw": "{{baseUrl}}/orders/",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "orders"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"customer_id\": 1,\n  \"items\": [\n    {\n      \"book_id\": {{bookId}},\n      \"quantity\": 2\n    }\n  ]\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Статус 201\", () => pm.response.to.have.status(201));",
              "const order = pm.response.json();",
              "pm.test(\"Статус замовлення processing\", () => pm.expect(order.status).to.eql(\"processing\"));",
              "pm.test(\"Сума замовлення\", () => pm.expect(order.total).to.eql(24));",
              "pm.collectionVariables.set(\"orderId\", order.id);"
            ]
          }
        }
      ]
    },
