{
  "info": {
    "name": "Книжковий магазин",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Додати книгу",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/books/",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "books"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"isbn\": \"{{$timestamp}}\",\n  \"title\": \"Python Programming\",\n  \"author\": \"John Doe\",\n  \"price\": 10.5,\n  \"quantity\": 5,\n  \"description\": \"Підручник\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Статус 201\", () => pm.response.to.have.status(201));",
              "const book = pm.response.json();",
              "pm.test(\"Книга збережена\", () => pm.expect(book.title).to.eql(\"Python Programming\"));",
              "pm.collectionVariables.set(\"bookId\", book.id);",
              "pm.collectionVariables.set(\"bookIsbn\", book.isbn);"
            ]
          }
        }
      ]
    },
    {
      "name": "Додати книгу з існуючим ISBN",
      "request": {
        "method": "POST",
        "header": [
