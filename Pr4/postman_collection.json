          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Статус 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"ID збігається\", () => pm.expect(pm.response.json().id).to.eql(Number(pm.collectionVariables.get(\"bookId\"))));"
            ]
          }
        }
      ]
    },
    {
      "name": "Оновити книгу",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/books/{{bookId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "books",
            "{{bookId}}"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"price\": 12,\n  \"quantity\": 8,\n  \"description\": \"Нове видання\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Статус 200\", () => pm.response.to.have.status(200));",
              "const book = pm.response.json();",
              "pm.test(\"Дані оновлено\", () => {",
              "    pm.expect(book.price).to.eql(12);",
              "    pm.expect(book.quantity).to.eql(8);",
              "});"
            ]
          }
        }
      ]
    },
