                  "key": "email",
                  "value": "john.doe@example.com"
                }
              ]
            },
            "description": "Пошук за email у цьому API не реалізовано. Запит виконано за умовою завдання; очікувана відповідь 400/404."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Статус один з [400, 404]\", function () { pm.expect([400, 404]).to.include(pm.response.code); });",
                  "// Сервіс НЕ має ендпоінта /contacts/search: \"search\" сприймається як невалідний ID.",
                  "pm.expect(pm.response.text()).to.include(\"Invalid Contact ID\");"
                ]
              }
            }
          ]
        },
