            "description": "",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"firstName\": \"John\",\n  \"lastName\": \"Doe\",\n  \"birthdate\": \"1990-01-15\",\n  \"email\": \"john.doe@example.com\",\n  \"phone\": \"1234567890\",\n  \"street1\": \"123 Main St\",\n  \"street2\": \"Apt 1\",\n  \"city\": \"Kyiv\",\n  \"stateProvince\": \"Kyiv\",\n  \"postalCode\": \"01001\",\n  \"country\": \"Ukraine\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Статус 201\", function () { pm.response.to.have.status(201); });",
                  "const j = pm.response.json();",
                  "pm.test(\"Є _id\", function () { pm.expect(j._id).to.be.a(\"string\"); });",
                  "pm.test(\"Ім'я збігається\", function () { pm.expect(j.firstName).to.eql(\"John\"); });",
                  "pm.environment.set(\"contactId\", j._id);"
                ]
